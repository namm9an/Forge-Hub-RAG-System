# Copy to .env for standalone backend development. Keep populated credentials private.

# Backend
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Security
ENVIRONMENT=development
STORAGE_MODE=postgres
# Backend verifies RS256 tokens from your selected identity provider.
# Paste only its PUBLIC PEM; never a private signing key. Issuer/audience must match tokens.
AUTH_PUBLIC_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Explicit migration opt-in. Inspect migrations/backup before enabling on existing data.
RUN_MIGRATIONS=false

# External services (placeholders)
VECTOR_DB_URL=
# Used only by the local development database compose file; set a private value.
FORGE_HUB_POSTGRES_PASSWORD=
VECTOR_DB_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# When LLM_PROVIDER=gemini, set a Gemini model ID enabled in your Google project.
LLM_MODEL=qwen/qwen3-coder:free
